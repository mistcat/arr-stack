{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Denver",
  "schedule": [
    "* * * * 1"
  ],
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "automerge": false,
  "automergeType": "branch",
  "ignoreTests": true,
  "packageRules": [
    {
      "description": "Unattended updates. Flip automerge to true after rollback is proven (plan Task 11).",
      "matchDatasources": [
        "docker"
      ],
      "automerge": false
    },
    {
      "description": "Guided systems: PRs only, never automerge. Keep this rule last.",
      "matchPackageNames": [
        "qmcgaw/gluetun",
        "pihole/pihole",
        "klutchell/dnscrypt-proxy"
      ],
      "automerge": false
    }
  ]
}